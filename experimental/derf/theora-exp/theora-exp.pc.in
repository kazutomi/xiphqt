# theora installed pkg-config file

prefix=@prefix@
exec_prefix=@exec_prefix@
libdir=@libdir@
includedir=@includedir@

Name: theora-exp
Description: Theora experimental video codec
Version: @VERSION@
Requires: ogg >= 1.1.1
Conflicts:
Libs: -L${libdir} -ltheorabase -ltheoraenc -ltheoraadec
Cflags: -I${includedir}
