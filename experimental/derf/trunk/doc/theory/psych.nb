Cell[BoxData[
    \(<< Graphics`MultipleListPlot`\)], "Input"],

Cell[BoxData[
    \(trapezoidal[l_, h_] := 
      \((h/\((Length[l] - 1)\))\)*
        \((\((1/2)\)*\((l[\([1]\)] + l[\([Length[l]]\)])\) + 
            \((Plus@@Take[l, {2, Length[l] - 1}])\))\)\)], "Input"],

Cell[BoxData[
    \(simpson[l_, h_] := 
      \((h/\((3*Length[l] - 3)\))\)*
        \((Plus@@
            MapIndexed[#1*
                  \((\(If[EvenQ[#], 4, If[# > 1 && # < Length[l], 2, 1]]&
                        \)[#2[\([1]\)]])\)&, l])\)\)], "Input"],

Cell[BoxData[
    \(mag[v_] := Sqrt[Plus@@\((\(#*#&\)/@v)\)]\)], "Input"],

Cell[BoxData[
    \(dint[0, b_, s_, fmax_, a_, n_, ftable_] := 
      simpson[MapIndexed[#1*s[\((\((#2[\([1]\)] - 1)\)/n)\)*fmax]&, ftable], 
        mag[a[\([b + 1]\)]]/\((\[Pi]*simpson[ftable, 1])\)]\)], "Input"],

Cell[BoxData[
    \(dint[k_, b_, s_, fmax_, a_, n_, ftable_] := 
      2*simpson[
          MapIndexed[#1*s[\((\((#2[\([1]\)] - 1)\)/n)\)*fmax]*
                Cos[k*\((\((#2[\([1]\)] - 1)\)/n)\)*Length[a]*\[Pi]]&, 
            ftable], mag[a[\([b + 1]\)]]/\((\[Pi]*simpson[ftable, 1])\)]\)], 
  "Input"],

Cell[BoxData[
    \(d[k_, b_, s_, fmax_, a_, n_] := 
      dint[k, b, s, fmax, a, n, 
        Sqrt[2*n]*
          Drop[Abs[
              Fourier[Join[a[\([b + 1]\)], 
                  Table[0, {2*n - Length[a[\([b + 1]\)]]}]]]], \(-n\) + 1]]
        \)], "Input"],

