<%@ page imports="siteconfig,softwarenews" %>
<html>
<body bgcolor=white>

<a href="edit_softwarenews.psp" target="content">Add/Edit a Software News Item</a><br>
<hr>
<% snl = softwarenews.SoftwareNewsList() %>
<% for sn in snl.list: %>
[<a href="edit_softwarenews.psp?id=<%= sn.id %>" target="content">edit</a>] - [<a href="del_softwarenews.psp?id=<%= sn.id %>" target="content">delete</a>]<br>
<br>
<font size="+2"><b><%= sn.title %></b></font><br>
<font size="-1">added on <i><%= sn.date_added %></i></font><br>
<br>
<%= sn.html_blurb() %>
<br><br>
<% end %>
<hr>

</body>
</html>
