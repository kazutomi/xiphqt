<%@ page imports="siteconfig,category" indentType="braces" %>
<%
if req.field('id', default=None): {
	c = category.Category(req.field('id'))
	c.load()
%>
<html>
<body bgcolor=white>
<h1>Really Delete "<%= c.name %>"<h1>
<hr>

<form method=post action="del_category2.psp">
<input type=hidden name=id value="<%= c.id %>">
<input type=submit value="Yes, Delete It">
</form>

<br>
<a href="categories.psp" target="content">No, Go Back To Categories Page</a>

</body>
</html>
<%
} else: {
%>
<html>
<body bgcolor=white>
<h1>Nothing to delete<h1>
<hr>

<br>
<a href="categories.psp" target="content">Go Back To Categories Page</a>

</body>
</html>
<%
}
%>
