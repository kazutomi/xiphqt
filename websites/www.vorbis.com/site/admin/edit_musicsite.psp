<%@ page imports="siteconfig,musicsite" indentType="braces" %>
<%
if req.field('id', default=None): {
	ms = musicsite.MusicSite(req.field('id'))
	ms.load()
} else: {
	ms = musicsite.MusicSite(id=None, url='', name='', blurb='', date_added=None)
}
%>

<html>
<body bgcolor=white>
<h1>Add/Edit a Music Site<h1>
<hr>

<form method=post action="edit_musicsite2.psp">
<% if ms.date_added: { %>
<input type=hidden name=date_added value="<%= ms.date_added %>">
<% } %>
<% if ms.id: { %>
<input type=hidden name=id value="<%= ms.id %>">
<% } %>
<table border=0>
<tr>
<td>URL:</td><td><input type=text name=url size=30 value="<%= ms.url %>"></td>
</tr><tr>
<td>Name:</td><td><input type=text name=name size=50 value="<%= ms.name %>"></td>
</tr><tr>
<td colspan=2>
Blurb:<br>
<textarea name=blurb cols=40 rows=10><%= ms.blurb %></textarea>
</td><td></td>
</tr>
</table>
<input type=submit value="Add/Edit Music Site">
</form>

</body>
</html>





