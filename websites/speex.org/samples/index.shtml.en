	<li><a href="audio/female_speex_4_vbr.wav">coded 4 kbps VBR</a></li>
	<li><a href="audio/female_speex_6.wav">coded 6 kbps</a></li>
	<li><a href="audio/female_speex_8.wav">coded 8 kbps</a></li>
	<li><a href="audio/female_speex_8_vbr.wav">coded 8 kbps VBR</a></li>
