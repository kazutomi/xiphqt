        <li class='original'><a href='male.wav'>Original</a></li>
        <li><a href='male_speex_8.wav'>coded 8 kbps</a></li>
        <li><a href='male_speex_8_vbr.wav'>coded 8 kbps VBR</a></li>
        <li><a href='male_speex_11.wav'>coded 11 kbps</a></li>
        <li><a href='male_speex_15.wav'>coded 15 kbps</a></li>
    </ul>

    <h2>Female Sample</h2>
