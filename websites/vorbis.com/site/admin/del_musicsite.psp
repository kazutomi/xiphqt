<%@ page imports="siteconfig,musicsite" indentType="braces" %>
<%
if req.field('id', default=None): {
	ms = musicsite.MusicSite(req.field('id'))
	ms.load()
%>
<html>
<body bgcolor=white>
<h1>Really Delete "<%= ms.name %>"<h1>
<hr>

<form method=post action="del_musicsite2.psp">
<input type=hidden name=id value="<%= ms.id %>">
<input type=submit value="Yes, Delete It">
</form>

<br>
<a href="musicsites.psp" target="content">No, Go Back To Music Sites Page</a>

</body>
</html>
<%
} else: {
%>
<html>
<body bgcolor=white>
<h1>Nothing to delete<h1>
<hr>

<br>
<a href="musicsites.psp" target="content">Go Back To Music Sites Page</a>

</body>
</html>
<%
}
%>
