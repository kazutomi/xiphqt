<%@ page imports="siteconfig,news,type" indentType="braces" %>
<%
n = news.News(id=req.field('id', None), type=req.field('type', None), poster=req.field('poster', None), title=req.field('title', None), blurb=req.field('blurb', None), date_added=req.field('date_added', None))
%>

<html>
<body bgcolor=white>
<% if n.save(): { %>
<h1> News added/updated successfully. </h1>
<a href="news.psp" target="content">Back To News Page</a>
<% } else: { %>
<h1> Add/update failed.  Please hit 'back' and try again. </h1>
<% } %>


</body>
</html>