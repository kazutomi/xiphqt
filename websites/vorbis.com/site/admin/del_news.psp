<%@ page imports="siteconfig,type,news" indentType="braces" %>
<%
if req.field('id', default=None): {
	n = news.News(req.field('id'))
	n.load()
%>
<html>
<body bgcolor=white>
<h1>Really Delete "<%= n.title %>"<h1>
<hr>

<form method=post action="del_news2.psp">
<input type=hidden name=id value="<%= n.id %>">
<input type=submit value="Yes, Delete It">
</form>

<br>
<a href="news.psp" target="content">No, Go Back To News Page</a>

</body>
</html>
<%
} else: {
%>
<html>
<body bgcolor=white>
<h1>Nothing to delete<h1>
<hr>

<br>
<a href="news.psp" target="content">Go Back To News Page</a>

</body>
</html>
<%
}
%>
