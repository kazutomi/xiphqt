<%@ page imports="siteconfig,news,musicsite,softwarenews,globalfuncs,link" %>
<psp:insert file="header.html" static="0">
<psp:insert file="globalnav.html" static="0">
<psp:insert file="topnav.html" static="0">

<table broder="0" width="100%" cellpadding="0" cellspacing="0">
<tr valign="top">
	<td width="70%">
	<%= globalfuncs.get_about_box() %>
	<%= globalfuncs.get_feature_box() %>
	<%= news.get_news_box(siteconfig.NEWS) %>
	</td>

	<td width="30%">

	<!-- GET VORBIS BANNER -->
	<table border="0" align="center" class="defaultborder">
	<tr><td align="center"><a href="/download.psp"><img src="http://fatpipe.vorbis.com/images/banner.png" width="351" height="60" border="0"></a></td></tr>
	</table>
	<!-- /GET VORBIS BANNER -->

	<%= softwarenews.get_softwarenews_box(siteconfig.SOFTWARE) %>
	<%= musicsite.get_musicsite_box(siteconfig.MUSICSITES) %>
	<%= link.get_link_box(siteconfig.LINKS) %>
	</td>
</tr>
</table>

<psp:insert file="footer.html" static="0">
