<%@ page imports="infobox" %>
<a name="top">
<psp:insert file="header.html" static="0">
<psp:insert file="globalnav.html" static="0">
<psp:insert file="topnav.html" static="0">

<%
box = infobox.InfoBox()
box.title = 'For Developers'
box.fontsize = -1
box.title_image = '/images/NewsBox-bg.png'
box.title_image_r = '/images/NewsBox-right-bg.png'

self.write(box.start())
%>


<br><br>
If you're a developer or interested in the Ogg Vorbis technology, please visit our 
developer site at <a href="http://www.xiph.org/ogg/vorbis/">www.xiph.org/ogg/vorbis</a>. 
There you can get access to the latest Ogg Vorbis code as well as the developer 
community and related tools.
<br><br>

<%
self.write(box.finish())
%>

<psp:insert file="footer.html" static="0">



